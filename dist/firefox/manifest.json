{
  "manifest_version": 3,
  "name": "WhatsApp Privacy Shield by Rahul Saini",
  "version": "1.0.4",
  "description": "Blur matching WhatsApp Web chats. Reveal on hover or focus, with local on/off and strength controls.",
  "homepage_url": "https://www.irahulsaini.com/tools/whatsapp-privacy-shield",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "privacy.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "WhatsApp Privacy Shield",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "whatsapp-privacy-blur@irahulsaini.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
